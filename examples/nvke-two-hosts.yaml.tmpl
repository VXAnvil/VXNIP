# Set the Kubernetes version to the version prepared on both Linux hosts.
name: vmetal-nvke-lab
controlPlaneKubernetesVersion: "${KUBERNETES_VERSION}"
cniPlugin: ovn-kubernetes
etcdEncrypted: false
controlPlaneConfig:
  desiredCount: 1
  systemReservedMemory: "1Gi"
  infra:
    machineTemplate:
      apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
      kind: VMetalMachineTemplate
      spec:
        template:
          spec:
            hostRef: "${CONTROL_PLANE_HOST}"
            bootstrapMode: NVKE
nodePools:
  - name: worker
    nodeNamePrefix: w
    desiredNodeCount: 1
    controlPlane: false
    systemReservedMemory: "1Gi"
    nodeLabels:
      tier: compute
    autoProvisionDisabled: false
    autoModeDisabled: false
    recycleBudget: 0
    infra:
      machineTemplate:
        apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
        kind: VMetalMachineTemplate
        spec:
          template:
            spec:
              hostRef: "${WORKER_HOST}"
              bootstrapMode: NVKE
infra:
  cluster:
    apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
    kind: VMetalCluster
    metadata:
      name: vmetal-nvke-lab
    spec:
      controlPlaneEndpoint:
        host: "${CONTROL_PLANE_IP}"
        port: 6443
