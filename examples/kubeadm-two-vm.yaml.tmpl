apiVersion: vxnip.infrastructure.cluster.x-k8s.io/v1alpha1
kind: VXNIPHost
metadata:
  name: ${CONTROL_PLANE_HOST}
spec:
  machineID: "${CONTROL_PLANE_ID}"
  sshTarget: "${CONTROL_PLANE_SSH}"
  allowBootstrap: true
---
apiVersion: vxnip.infrastructure.cluster.x-k8s.io/v1alpha1
kind: VXNIPHost
metadata:
  name: ${WORKER_HOST}
spec:
  machineID: "${WORKER_ID}"
  sshTarget: "${WORKER_SSH}"
  allowBootstrap: true
---
apiVersion: vxnip.infrastructure.cluster.x-k8s.io/v1alpha1
kind: VXNIPCluster
metadata:
  name: vxnip-lab
  namespace: default
spec:
  controlPlaneEndpoint:
    host: "${CONTROL_PLANE_IP}"
    port: 6443
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: vxnip-lab
  namespace: default
spec:
  clusterNetwork:
    pods:
      cidrBlocks: ["10.244.0.0/16"]
    services:
      cidrBlocks: ["10.96.0.0/12"]
    serviceDomain: cluster.local
  infrastructureRef:
    apiGroup: vxnip.infrastructure.cluster.x-k8s.io
    kind: VXNIPCluster
    name: vxnip-lab
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: vxnip-lab
---
apiVersion: vxnip.infrastructure.cluster.x-k8s.io/v1alpha1
kind: VXNIPMachineTemplate
metadata:
  name: vxnip-lab-control-plane
  namespace: default
spec:
  template:
    spec:
      hostRef: ${CONTROL_PLANE_HOST}
---
apiVersion: vxnip.infrastructure.cluster.x-k8s.io/v1alpha1
kind: VXNIPMachineTemplate
metadata:
  name: vxnip-lab-worker
  namespace: default
spec:
  template:
    spec:
      hostRef: ${WORKER_HOST}
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: vxnip-lab
  namespace: default
spec:
  version: "${KUBERNETES_VERSION}"
  replicas: 1
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: vxnip.infrastructure.cluster.x-k8s.io
        kind: VXNIPMachineTemplate
        name: vxnip-lab-control-plane
  kubeadmConfigSpec:
    initConfiguration:
      localAPIEndpoint:
        advertiseAddress: "${CONTROL_PLANE_IP}"
      nodeRegistration:
        criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: vxnip-lab-worker
  namespace: default
spec:
  template:
    spec:
      joinConfiguration:
        nodeRegistration:
          criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: vxnip-lab-worker
  namespace: default
spec:
  clusterName: vxnip-lab
  replicas: 1
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: vxnip-lab
  template:
    spec:
      clusterName: vxnip-lab
      version: "${KUBERNETES_VERSION}"
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: vxnip-lab-worker
      infrastructureRef:
        apiGroup: vxnip.infrastructure.cluster.x-k8s.io
        kind: VXNIPMachineTemplate
        name: vxnip-lab-worker
